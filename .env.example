# FieldSync - Configuration exemple (copier en .env et remplir)

# Application
APP_ENV=development
DEBUG_MODE=true

# Base de données
DB_HOST=localhost
DB_NAME=fieldsync
DB_USER=root
DB_PASSWORD=

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre_email@gmail.com
MAIL_PASSWORD=votre_mot_de_passe_app
MAIL_FROM_ADDRESS=notifications@fieldsync.com
MAIL_FROM_NAME=FieldSync

# SMS - TextBelt
SMS_PROVIDER=textbelt
SMS_TEXTBELT_KEY=textbelt
